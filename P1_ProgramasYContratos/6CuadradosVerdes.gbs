program {
    /*
        PROPÓSITO:  Quita un cuadrado con bolitas verdes de tamaño 3x3 en la posición (1,1) del tablero.
    */
    Sacar(Verde)
    Mover(Norte)
    Sacar(Verde)
    Mover(Este)
    Sacar(Verde)
    Mover(Sur)
    Sacar(Verde)
    Mover(Sur)
    Sacar(Verde)
    Mover(Oeste)
    Sacar(Verde)
    Mover(Oeste)
    Sacar(Verde)
    Mover(Norte)
    Sacar(Verde)
    Mover(Norte)
    Sacar(Verde)
    Mover(Este)
    Mover(Sur)
}