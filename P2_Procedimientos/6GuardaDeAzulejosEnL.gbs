

/*
6. Guarda de azulejos en L
Hacer un procedimiento PonerGuardaEnL(), que arme una guarda en L como muestra la figura, dejando el
cabezal en la posición inicial.

¿Pensaste en reutilizar el procedimiento definido antes, o empezaste a escribirlo de nuevo? Dado que ahora se
cuenta con la subtarea definida en el ejercicio anterior, la metodología top-down se puede enriquecer con la
reutilización de procedimientos ya realizados; esto puede hacer que ciertas divisiones en subtareas, que
permiten esa reutilización, sean más sencillas que otras.
*/

procedure PonerGuardaEnL(){
    /*
        Propósito:
            Coloca 2 azulejos de color Verde, Negro y Rojo como guarda en forma de L 3x3.
        Precondición:
            * El tablero debe poseer mínimo 2 celdas disponibles al norte y 2 al este del cabezal.
            * El cabezal debe estar posicionado en la posición (0,0).
    */
    PonerGuardaEnVerticalDe2Azulejos()
    PonerGuardaEnHorizontalDe3Azulejos()
}

procedure PonerGuardaEnVerticalDe2Azulejos(){
    /*
        Propósito:
            Coloca 2 azulejos en una columna vertical.
        Precondición:
            * El tablero debe poseer mínimo 2 celdas disponibles al norte del cabezal.
            * El cabezal debe estar posicionado en la posición (0,0).
    */
    Mover(Norte)
    PonerAzulejo()
    Mover(Norte)
    PonerAzulejo()
    IrAlBorde(Sur)
}

procedure PonerGuardaEnHorizontalDe3Azulejos(){
    /*
        Propósito:
            Coloca 3 azulejos en una fila horizontal.
        Precondición:
            * El tablero debe poseer mínimo 2 celdas disponibles al este del cabezal.
            * El cabezal debe estar posicionado en la posición (0,0).
    */
    PonerAzulejo()
    Mover(Este)
    PonerAzulejo()
    Mover(Este)
    PonerAzulejo()
    IrAlBorde(Oeste)
}

program {
    /*
        Propósito:
            Coloca una guarda de azulejos en forma de L 3x3
        Precondición:
            * Debe haber al menos 2 celdas disponibles al norte y 2 al este del cabezal.
    */
    PonerGuardaEnL()
}