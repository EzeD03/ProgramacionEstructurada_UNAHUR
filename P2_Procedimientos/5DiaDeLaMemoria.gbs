program {
    /*
        PROPÓSITO:
            Ejecutar el procedimiento para registrar el Día de la Memoria por la Verdad y la Justicia en Argentina.
        PRECONDICIONES:
            * El tablero debe estar vacío o preparado para recibir las bolitas de colores antes de ejecutar el programa.
    */
    RegistrarElDíaDeLaMemoria()
}