/*
Escribir un procedimiento PintarElTableroDeAzul() que, asumiendo que el tablero tiene 10 celdas de largo y 7
celdas de alto, pinte absolutamente todo el tablero con bolitas azules, dejando exactamente una bolita azul en
cada celda. Se pregunta:
    ▪ ¿Cuál es la precondición del procedimiento?
    ▪ ¿Se le ocurre otra estrategia para resolver el problema?
*/

procedure PintarElTableroDeAzul(){
    /*
        Propósito: Pinta un tablero de 10 celdas de largo y 7 de alto en color azul.
        Precondiciones:
            * El tablero debe tener mínimo 10 celdas de largo y 7 de alto.
            * Las celdas deben estar vacías.
    */
    PintarLineaDe10Azules()
    Pintar6LineasDe10Azules()
}

procedure Pintar6LineasDe10Azules(){
    /*
        Propósito: Dibuja 6 lineas azules consecutivas una sobre otra de 10 celdas de largo.
        Precondiciones:
            * Debe haber mínimo 9 celdas al Este y 5 al Norte disponibles.
            * Las celdas deben estar vacías 
    */
    repeat (6) {
        IrAlInicioDeSiguienteLinea()
        PintarLineaDe10Azules()
    }
}

procedure PintarLineaDe10Azules(){
    /*
        Propósito: Dibuja una linea de 10 celdas azules y regresa a la posición inicial de la línea.
        Precondiciones:
            * Debe haber mínimo 9 celdas disponibles al Este de la celda actual.
    */
    Poner(Azul)
    repeat (9) {
        Mover(Este)
        Poner(Azul)
    }
    RegresarAlInicioDeLaLineaAzul()
}

procedure IrAlInicioDeSiguienteLinea(){
    /*
        Propósito: Mueve el cabezal a la posición de la siguiente línea a dibujar.
        Precondiciones:
            * Debe haber mínimo 1 celda al Norte de la celda actual.
    */
    Mover(Norte)
}

procedure RegresarAlInicioDeLaLineaAzul(){
    /*
        Propósito: Mueve el cabezal 9 celdas al Oeste de la celda actual hacia el inicio de la línea.
        Precondiciones:
            * Debe haber mínimo 9 celdas disponibles al Oeste de la celda actual.
    */
    repeat (9) {
        Mover(Oeste)
    }
}

program {
    /*
        Prropósito: Pinta un tablero de 10 celdas de largo y 7 de alto en color azul.
        Precondiciones:
            * El tablero debe tener mínimo 10 celdas de largo y 7 de alto.
            * Las celdas deben estar vacías.
    */
    PintarElTableroDeAzul()
}