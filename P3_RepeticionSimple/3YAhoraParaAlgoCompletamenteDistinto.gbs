/*
    Escribir un procedimiento Poner6DeColorNegro() que ponga 6 bolitas de color Negro en la celda actual.
*/

procedure Poner6DeColorNegro(){
    /*
        Propósito: Coloca 6 bolitas de color negro en la celda actual
        Precondiciones:
            * Ninguna.
    */
    repeat (6) {
        Poner(Negro)
    }
}